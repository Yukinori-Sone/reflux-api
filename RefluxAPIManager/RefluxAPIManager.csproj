<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Reflux API Manager: tray tool next to Reflux.exe for the Reflux API Server service on the game PC (state, settings, service control) and the result screen screenshots. Targets .NET Framework 4.8, which every Windows 10/11
    already has: no runtime to install and a small exe next to Reflux.exe.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>RefluxAPIManager</RootNamespace>
    <AssemblyName>RefluxAPIManager</AssemblyName>
    <Version>0.1.0</Version>
    <Product>Reflux API Manager</Product>
    <AssemblyTitle>Reflux API Manager</AssemblyTitle>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="SharpDX.Direct3D11" Version="4.2.0" />
    <PackageReference Include="SharpDX.DXGI" Version="4.2.0" />
    <PackageReference Include="SharpZipLib" Version="1.3.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\icon.ico" LogicalName="icon.ico" />
  </ItemGroup>

  <!--
    SharpDX (Desktop Duplication for the result screenshots) and SharpZipLib (their PNG compression) go inside the exe, so the monitor stays a single file. Program.LoadEmbeddedAssembly loads it from the resources.
  -->
  <Target Name="EmbedReferencedAssemblies" AfterTargets="ResolveReferences">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'" LogicalName="lib.%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll' Or '%(ReferenceCopyLocalPaths.Extension)' == '.xml'" />
    </ItemGroup>
  </Target>

</Project>
